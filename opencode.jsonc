{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot-mcp-runtime": {
      "type": "local",
      // TEMPORARY: pinned to the fork branch feat/inline-resource-construction
      // (commit 617963a) to test inline Resource construction before opening a
      // PR. REVERT CONDITION: revert to the published release
      // (godot-mcp-runtime@>=3.3) as soon as the PR is merged and released —
      // fork branch MUST NOT become a long-term dependency (lifecycle:
      // docs/upstream-backlog.md, "inline Resource construction").
      // History: v3.2.4 shipped our PRs #28 (relative-projectPath, v3.2.3),
      // #29 (property type-validation) and #30 (progress heartbeats);
      // contribution roadmap lives at
      // plans/roadmap-godot-mcp-contributions/.
      "command": ["npx", "-y", "github:mcanevet/godot-mcp-runtime#feat/inline-resource-construction"],
      "enabled": true,
      // DEBUG=true routes [DEBUG] spawn/port/bridge telemetry from the MCP
      // server's stderr into ~/.local/share/opencode/log/opencode.log —
      // essential for diagnosing run_project bridge timeouts.
      "env": { "DEBUG": "true" },
    },
  },
  "lsp": {
    "gdscript": {
      "command": ["npx", "opencode-godot-lsp@1.0.1"],
      "extensions": [".gd", ".gdshader"],
    },
  },
  "agent": {
    "build": {
      // Structural iteration cap referenced in agents/build.md's Anti-Recursion Guards.
      // When reached, opencode forces a text-only summary instead of relying on the
      // model to self-count loop iterations.
      "steps": 300,
    },
  },
}
