{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot-mcp-runtime": {
      "type": "local",
      // v3.2.4: includes our PRs #28 (relative-projectPath, v3.2.3),
      // #29 (property type-validation) and #30 (progress heartbeats).
      // The fork-branch workaround is fully retired (see
      // docs/upstream-backlog.md); contribution roadmap lives at
      // plans/roadmap-godot-mcp-contributions/.
      "command": ["npx", "-y", "godot-mcp-runtime@3.2.4"],
      "enabled": true,
      // DEBUG=true routes [DEBUG] spawn/port/bridge telemetry from the MCP
      // server's stderr into ~/.local/share/opencode/log/opencode.log —
      // essential for diagnosing run_project bridge timeouts.
      "env": { "DEBUG": "true" },
    },
  },
  "lsp": {
    "gdscript": {
      "command": ["npx", "opencode-godot-lsp@1.0.1"],
      "extensions": [".gd", ".gdshader"],
    },
  },
  "agent": {
    "build": {
      // Structural iteration cap referenced in agents/build.md's Anti-Recursion Guards.
      // When reached, opencode forces a text-only summary instead of relying on the
      // model to self-count loop iterations.
      "steps": 300,
    },
  },
}
