{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot-mcp-runtime": {
      "type": "local",
      // History: v3.2.4 shipped our PRs #28 (relative-projectPath, v3.2.3),
      // #29 (property type-validation) and #30 (progress heartbeats);
      // v3.2.5 shipped PR #32 (inline Resource construction); v3.3.0 shipped
      // #33 error diagnostics, #34 scene instancing, #35 batch promoted-params
      // plus maintainer follow-ups — all fork pins for those retired
      // (lifecycle: docs/upstream-backlog.md).
      //
      // TEMPORARY local checkout pin (start 2026-09-08): local disk path to
      // Erodenn/godot-mcp-runtime branch repro/ext-resource-id-collision
      // @ a787f89 (includes d388852 — fix for silent data loss:
      // set_node_properties on nodes inside an instanced child reported
      // success but pack() dropped the override; tests 75/75 green).
      // Pre-PR testing only. REVERT condition: replace with the published
      // package version once the PR is merged and released (>= v3.3.1),
      // then retire the entry in docs/upstream-backlog.md.
      "command": ["node", "/Users/mcanevet/src/github.com/Erodenn/godot-mcp-runtime/dist/index.js"],
      "enabled": true,
      // DEBUG=true routes [DEBUG] spawn/port/bridge telemetry from the MCP
      // server's stderr into ~/.local/share/opencode/log/opencode.log —
      // essential for diagnosing run_project bridge timeouts.
      "env": { "DEBUG": "true" },
    },
  },
  "lsp": {
    "gdscript": {
      "command": ["npx", "opencode-godot-lsp@1.0.1"],
      "extensions": [".gd", ".gdshader"],
    },
  },
  "agent": {
    "build": {
      // Structural iteration cap referenced in agents/build.md's Anti-Recursion Guards.
      // When reached, opencode forces a text-only summary instead of relying on the
      // model to self-count loop iterations.
      "steps": 300,
    },
  },
}
